# virtualenvs
.venv/
venv/
env/

# python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# secrets and local config
.env
.env.*
*.pem
*.key

# captured demo transcripts (regenerated by running the demo)
demo/_run_*.txt

# broker durable state (broker/store.py). Local runtime state, not source: it holds
# the audit trail and the spent use budgets. -wal/-shm are SQLite's WAL sidecars.
# Per-port files look like warrant-8100.db (see demo/stack.py).
warrant.db
warrant.db-wal
warrant.db-shm
warrant-*.db
warrant-*.db-wal
warrant-*.db-shm
*.db-wal
*.db-shm

# throwaway dev scaffolding / screenshots
ui/_shot.py
ui/_mock_server.py
agent/_mock_broker.py
*_shot*.png
*.png

# local working notes / internal build contracts — not part of the public surface
CONTRACTS.md
*.md
!README.md
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Cursor / local agent tooling (not part of the Warrant product)
.agents/
skills-lock.json
